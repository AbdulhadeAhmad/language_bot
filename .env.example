# Copy to $LANGUAGE_BOT_DATA_DIR/.env and replace placeholders.
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgresql+asyncpg://language_bot:replace-with-a-url-safe-random-password@db:5432/language_bot
TELEGRAM_BOT_TOKEN=123456:replace-with-your-botfather-token
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
ADMIN_TELEGRAM_ID=123456789
ADMIN_NOTIFICATION_CHANNEL_ID=-1009876543210
# Used when archive storage is implemented in M4.
TELEGRAM_MEDIA_CHANNEL_ID=-1001234567890

# The model services load the pinned downloads under models/runtime.
# Bot model URLs are set by Compose; no model-library settings belong in the bot.
LOG_LEVEL=INFO
OPERATION_CONCURRENCY=4
OPERATION_TIMEOUT_SECONDS=900
